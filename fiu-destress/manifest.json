{
  "manifest_version": 3,
  "name": "FIU Finals Week Destress",
  "version": "1.0",
  "description": "A Chrome extension to help FIU students destress during finals week",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": ["storage", "notifications"],
  "web_accessible_resources": [
    {
      "resources": ["sounds/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["globals.css"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "open_canva": {
      "suggested_key": {
        "default": "c"
      },
      "description": "Open FIU Canva Login"
    }
  }
}
